{
  "name": "deepseek-harness",
  "displayName": "DeepSeek Harness",
  "description": "把 DeepSeek Harness 接入 VS Code 侧边栏：聊天 + 文件级代码审查（非官方社区扩展，ACP 自动化接口）",
  "version": "0.2.0",
  "publisher": "xliang",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "code-review",
    "acp"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:deepseekHarness.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DSH 会在工作区运行工具并修改文件。"
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "deepseekHarness",
          "title": "DeepSeek Harness",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "deepseekHarness": [
        {
          "id": "deepseekHarness.chat",
          "name": "对话",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseekHarness.openChat",
        "title": "DeepSeek Harness: 打开侧边栏",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.reviewFile",
        "title": "DeepSeek Harness: 审查当前文件",
        "category": "DeepSeek Harness",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deepseekHarness.reviewSelection",
        "title": "DeepSeek Harness: 审查选中代码",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.reviewChanges",
        "title": "DeepSeek Harness: 审查工作区改动",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.reviewStaged",
        "title": "DeepSeek Harness: 审查暂存区改动",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.reviewCommit",
        "title": "DeepSeek Harness: 审查某个提交",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.explainSelection",
        "title": "DeepSeek Harness: 解释选中代码",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.fixFindings",
        "title": "DeepSeek Harness: 修复最近审查发现的问题",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.showTurnChanges",
        "title": "DeepSeek Harness: 查看本轮改动",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.clearFindings",
        "title": "DeepSeek Harness: 清除审查结果",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.newSession",
        "title": "DeepSeek Harness: 新建会话",
        "category": "DeepSeek Harness",
        "icon": "$(add)"
      },
      {
        "command": "deepseekHarness.history",
        "title": "DeepSeek Harness: 会话历史",
        "category": "DeepSeek Harness",
        "icon": "$(history)"
      },
      {
        "command": "deepseekHarness.restartRuntime",
        "title": "DeepSeek Harness: 重启运行时",
        "category": "DeepSeek Harness",
        "icon": "$(debug-restart)"
      },
      {
        "command": "deepseekHarness.diagnose",
        "title": "DeepSeek Harness: 兼容性诊断",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.configure",
        "title": "DeepSeek Harness: 打开设置",
        "category": "DeepSeek Harness"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "deepseekHarness.reviewFile",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "deepseekHarness.reviewFile",
          "when": "resourceScheme == file",
          "group": "dsh@1"
        },
        {
          "command": "deepseekHarness.reviewSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "dsh@2"
        },
        {
          "command": "deepseekHarness.explainSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "dsh@3"
        }
      ],
      "view/title": [
        {
          "command": "deepseekHarness.newSession",
          "when": "view == deepseekHarness.chat",
          "group": "navigation@1"
        },
        {
          "command": "deepseekHarness.history",
          "when": "view == deepseekHarness.chat",
          "group": "navigation@2"
        },
        {
          "command": "deepseekHarness.restartRuntime",
          "when": "view == deepseekHarness.chat",
          "group": "navigation@3"
        },
        {
          "command": "deepseekHarness.clearFindings",
          "when": "view == deepseekHarness.chat",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "deepseekHarness.openChat"
        },
        {
          "command": "deepseekHarness.reviewFile"
        },
        {
          "command": "deepseekHarness.reviewSelection"
        },
        {
          "command": "deepseekHarness.reviewChanges"
        },
        {
          "command": "deepseekHarness.reviewStaged"
        },
        {
          "command": "deepseekHarness.reviewCommit"
        },
        {
          "command": "deepseekHarness.explainSelection"
        },
        {
          "command": "deepseekHarness.fixFindings"
        },
        {
          "command": "deepseekHarness.showTurnChanges"
        },
        {
          "command": "deepseekHarness.clearFindings"
        },
        {
          "command": "deepseekHarness.newSession"
        },
        {
          "command": "deepseekHarness.history"
        },
        {
          "command": "deepseekHarness.restartRuntime"
        },
        {
          "command": "deepseekHarness.diagnose"
        },
        {
          "command": "deepseekHarness.configure"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "deepseekHarness.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "`dsh` 可执行文件路径。留空自动探测（PATH / DSH 桌面端 / npx）。"
        },
        "deepseekHarness.profile": {
          "type": "string",
          "default": "acp",
          "markdownDescription": "启动的 DSH profile。留空则自动发现支持 ACP 的 profile（默认 `acp`）。"
        },
        "deepseekHarness.permissionMode": {
          "type": "string",
          "enum": [
            "workspace-write",
            "read-only",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "markdownDescription": "写入 `DSH_PERMISSION_MODE`。`read-only` 为严格模式：DSH 每次写文件/执行命令都会请求批准。修改后需重启运行时。"
        },
        "deepseekHarness.autoApprove": {
          "type": "string",
          "enum": [
            "ask",
            "all"
          ],
          "default": "ask",
          "markdownDescription": "`ask` 逐次弹窗批准；`all` 自动允许所有权限请求（危险）。"
        },
        "deepseekHarness.workspaceRootIndex": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "多根工作区时作为会话 cwd 的根目录下标（越界回退到第一个）。"
        },
        "deepseekHarness.maxReviewChars": {
          "type": "number",
          "default": 60000,
          "minimum": 2000,
          "description": "一次审查任务发送给 DSH 的最大字符数（超出按文件/行边界截断）。"
        },
        "deepseekHarness.autoContext": {
          "type": "string",
          "enum": [
            "selection-first",
            "file",
            "off"
          ],
          "default": "selection-first",
          "markdownDescription": "自动附带当前焦点编辑器的内容：`selection-first` 有选区带选区、否则带整个文件；`file` 只带整个文件；`off` 关闭自动上下文。"
        },
        "deepseekHarness.autoContextMaxChars": {
          "type": "number",
          "default": 40000,
          "minimum": 2000,
          "description": "自动上下文的最大字符数（超出按行截断）。"
        },
        "deepseekHarness.preferredModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "首选模型，格式 `provider/model`（例如 `deepseek-official/deepseek-flash`）。留空则读取 DSH 用户设置里的 `agent-default-model`，再退回上次选择。"
        },
        "deepseekHarness.hideLegacyModels": {
          "type": "boolean",
          "default": true,
          "description": "隐藏已下线的旧模型名（如 deepseek-v4-flash，实际由 DeepSeek-V4.1-Flash 提供）。"
        },
        "deepseekHarness.saveTranscriptLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "本地保留的会话记录数量。"
        },
        "deepseekHarness.showChangesNotice": {
          "type": "boolean",
          "default": true,
          "description": "DSH 一轮结束后，若检测到工作区改动则提示（可查看原生 diff）。"
        },
        "deepseekHarness.checkCompatOnVersionChange": {
          "type": "boolean",
          "default": true,
          "description": "检测到 DSH 版本变化时，后台运行兼容性自检并提示结果。"
        },
        "deepseekHarness.compat.autoRepair": {
          "type": "boolean",
          "default": true,
          "description": "ACP profile 启动失败时，允许提示用官方模板重建（会先备份原 profile）。"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "compat": "node scripts/compat.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ext": "node scripts/extension-smoke.mjs",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --allow-missing-repository --out deepseek-harness.vsix"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
